# ============================================================
# MessPulse Backend Environment Configuration
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# Example: postgresql://postgres:password@localhost:5432/messpulse
# Production (e.g. Neon, AWS RDS, Render, Railway):
# DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/messpulse?sslmode=require
DATABASE_URL=postgresql://localhost:5432/messpulse
DB_POOL_MAX=20

# JWT & Session Security
# Generate a strong secret with: openssl rand -base64 32
JWT_SECRET=change_this_to_a_secure_random_secret_in_production
JWT_EXPIRES_IN=24h
COOKIE_SECRET=change_this_to_a_secure_cookie_secret

# Cookie Configuration (Production defaults)
COOKIE_SAME_SITE=lax
# Set COOKIE_SECURE=true in production (HTTPS)
COOKIE_SECURE=false

# Allowed Frontend Origin(s) for CORS
# Single URL: http://localhost:5173
# Multiple comma-separated URLs: http://localhost:5173,https://messpulse.cutm.ac.in
FRONTEND_URL=http://localhost:5173

# Initial Seed Admin Account Credentials
ADMIN_NAME=Mess Administrator
ADMIN_EMAIL=admin@cutm.ac.in
ADMIN_REG_NO=ADMIN001
ADMIN_PASSWORD=AdminPass123
